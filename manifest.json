{
  "manifest_version": 3,
  "name": "Claude Perchance Renderer",
  "version": "0.5.0",
  "description": "Renders [[image: ...]] tags in Claude chats inline, using Perchance, Pollinations or AI Horde.",
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://*.claude.ai/*",
    "https://claude.com/*",
    "https://*.claude.com/*",
    "https://*.perchance.org/*",
    "https://perchance.org/*",
    "https://image.pollinations.ai/*",
    "https://gen.pollinations.ai/*",
    "https://aihorde.net/*",
    "https://*.aihorde.net/*",
    "https://*.r2.cloudflarestorage.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://*.claude.ai/*",
        "https://claude.com/*",
        "https://*.claude.com/*"
      ],
      "js": [
        "src/parse.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "https://perchance.org/*",
        "https://*.perchance.org/*"
      ],
      "js": [
        "src/perchance.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://image-generation.perchance.org/*"
      ],
      "js": [
        "src/perchance-main.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/render.html",
        "src/render.js",
        "src/content.css"
      ],
      "matches": [
        "https://claude.ai/*",
        "https://*.claude.ai/*",
        "https://claude.com/*",
        "https://*.claude.com/*"
      ]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "frame_headers",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "Claude Perchance settings",
    "default_popup": "src/options.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "claude-perchance@purdygeorgeedward-dev",
      "strict_min_version": "113.0"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "scripts": [
      "src/engines.js",
      "src/background.js"
    ]
  }
}
